# Copy to ".env" in this folder and adjust. Never commit the real .env.

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://pacs:change_me@localhost:5432/pacs

# Where DICOM / NIfTI file bytes are kept (metadata lives in PostgreSQL).
# Relative paths are relative to this backend-v2 folder.
STORAGE_DIR=storage

# Login session lifetime in hours.
SESSION_TTL_HOURS=12

# Browser origins allowed to call the API from another port (comma separated).
# Not needed when the frontend is served by this backend (http://localhost:8000/mypacs/...).
CORS_ORIGINS=

# Set to true only when the site is served over HTTPS (marks the login cookie Secure).
COOKIE_SECURE=false

# SATUSEHAT (ported in a later step). Empty = MOCK mode.
SATUSEHAT_ORG_ID=
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_BASE=https://api-satusehat-stg.dto.kemkes.go.id
SATUSEHAT_MOCK=
# Optional sandbox actors (defaults = SATUSEHAT's sandbox dummies):
# SATUSEHAT_PRACTITIONER_ID=10009880728
# SATUSEHAT_PATIENT_ID=P02478375538
# SATUSEHAT_LOCATION_ID=
